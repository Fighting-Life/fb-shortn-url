generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x", "darwin-arm64", "windows", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "debian-openssl-1.1.x"]
  previewFeatures = ["partialIndexes"]
  // output   = "../shared/utils/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
  suspended
}

enum UserRole {
  admin
  user
}

enum CampaignStatus {
  draft
  active
  paused
  archived
  blocked
}

enum ClickOutcome {
  target
  blocked
  expired
  bot
}

model User {
  id                  String               @id @default(cuid())
  name                String               @db.Text
  email               String               @unique @db.Text
  phone               String?              @unique @db.Text
  password_hash       String?              @db.Text
  avatar              String?              @db.Text
  role                UserRole             @default(user)
  status              UserStatus           @default(active)
  email_verified_at   DateTime?
  last_login_at       DateTime?
  is_active           Boolean              @default(true)
  created_at          DateTime             @default(now()) @db.Timestamptz
  updated_at          DateTime             @updatedAt @db.Timestamptz
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  systemLogs          SystemLog[]
  campaigns           Campaign[]
  sent_invitations    Invitation[]         @relation("InvitationSender")

  @@index([email], name: "user_email_idx")
  @@index([status], name: "user_status_idx")
  @@index([is_active], name: "user_is_active_idx")
  @@map("users")
}

model Account {
  id                  String  @id @default(cuid())
  user                User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id             String
  type                String
  provider            String
  provider_account_id String
  refresh_token       String? @db.Text
  access_token        String? @db.Text
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String? @db.Text
  session_state       String?

  @@unique([provider, provider_account_id], name: "account_provider_provider_account_id_unique")
  @@index([user_id], name: "account_user_id_idx")
  @@index([provider], name: "account_provider_idx")
  @@map("accounts")
}

model Session {
  id            String   @id @default(cuid())
  session_token String   @unique
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id       String
  expires       DateTime

  @@index([user_id], name: "session_user_id_idx")
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token], name: "verification_token_identifier_token_unique")
  @@index([token], name: "verification_token_token_idx")
  @@map("verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  token      String   @unique @db.Text
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires    DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([token], name: "password_reset_token_idx")
  @@index([user_id], name: "password_reset_user_id_idx")
  @@map("password_reset_tokens")
}

model Campaign {
  id              String                @id @default(cuid())
  owner_id        String
  name            String                @db.VarChar(160)
  short_code      String                @unique @db.VarChar(32)
  target_url      String                @db.Text
  blocked_url     String                @db.Text
  status          CampaignStatus        @default(draft)
  starts_at       DateTime?
  expires_at      DateTime?
  rule_config     Json?
  tracking_config Json?
  deleted_at      DateTime?
  created_at      DateTime              @default(now()) @db.Timestamptz
  updated_at      DateTime              @updatedAt @db.Timestamptz
  owner           User                  @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  click_events    ClickEvent[]
  daily_metrics   DailyCampaignMetric[]

  @@index([owner_id, status], name: "campaign_owner_status_idx")
  @@index([status, created_at], name: "campaign_status_created_idx")
  @@index([deleted_at], name: "campaign_deleted_idx")
  @@map("campaigns")
}

model ClickEvent {
  id               String       @id @default(cuid())
  campaign_id      String
  outcome          ClickOutcome
  device           String?      @db.VarChar(32)
  country          String?      @db.Char(2)
  referrer_host    String?      @db.VarChar(255)
  ip_hash          String?      @db.Char(64)
  attribution_hash String?      @db.Char(64)
  occurred_at      DateTime     @default(now()) @db.Timestamptz
  campaign         Campaign     @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id, occurred_at], name: "click_event_campaign_time_idx")
  @@index([outcome, occurred_at], name: "click_event_outcome_time_idx")
  @@index([country, occurred_at], name: "click_event_country_time_idx")
  @@map("click_events")
}

model DailyCampaignMetric {
  id             String   @id @default(cuid())
  campaign_id    String
  metric_date    DateTime @db.Date
  clicks         Int      @default(0)
  target_clicks  Int      @default(0)
  blocked_clicks Int      @default(0)
  bot_clicks     Int      @default(0)
  expired_clicks Int      @default(0)
  campaign       Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, metric_date], name: "daily_campaign_metric_campaign_date_unique")
  @@index([metric_date], name: "daily_campaign_metric_date_idx")
  @@map("daily_campaign_metrics")
}

model Invitation {
  id            String    @id @default(cuid())
  email         String    @db.Text
  name          String    @db.Text
  role          UserRole  @default(user)
  token_hash    String    @unique @db.Char(64)
  expires_at    DateTime  @db.Timestamptz
  accepted_at   DateTime?
  invited_by_id String
  invited_by    User      @relation("InvitationSender", fields: [invited_by_id], references: [id], onDelete: Cascade)
  created_at    DateTime  @default(now()) @db.Timestamptz

  @@index([email], name: "invitation_email_idx")
  @@index([expires_at], name: "invitation_expiry_idx")
  @@index([invited_by_id], name: "invitation_sender_idx")
  @@map("invitations")
}

model Setting {
  id         String   @id @default(cuid())
  key        String   @db.Text
  value      String   @db.Text
  group_name String   @db.Text
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  @@unique([key, group_name], name: "setting_key_group_name_unique")
  @@index([key], name: "setting_key_idx")
  @@index([group_name], name: "setting_group_name_idx")
  @@map("settings")
}

model AuditLog {
  id          String   @id @default(cuid())
  user_id     String
  action      String   @db.VarChar(100)
  resource    String   @db.VarChar(100)
  resource_id String?
  old_value   Json?
  new_value   Json?
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.Text
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], name: "idx_audit_logs_user_id")
  @@index([action], name: "idx_audit_logs_action")
  @@index([created_at], name: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

model SystemLog {
  id         String   @id @default(cuid())
  user_id    String?
  level      String   @db.VarChar(20) // info/warn/error/fatal
  service    String   @db.VarChar(100) // api/worker/queue/scheduler
  message    String   @db.Text
  context    Json?
  created_at DateTime @default(now()) @db.Timestamptz
  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@unique([id, created_at], name: "system_logs_pkey")
  @@index([level], name: "idx_system_logs_level")
  @@index([service], name: "idx_system_logs_service")
  @@index([created_at], name: "idx_system_logs_created_at")
  @@index([user_id], name: "idx_system_logs_user_id")
  @@map("system_logs")
}
